import socket
import time
client_id = input("Enter Client ID: ")
server_ip = input("Enter Server IP Address: ")
port = int(input("Enter Port Number: "))
protocol = input("Select Protocol (TCP/UDP): ").strip().upper()
if protocol == "TCP":
 sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
 sock.settimeout(5)
 sock.connect((server_ip, port)) # three-way handshake
 print("Connection Status : CONNECTED (TCP)")
else:
 sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
 sock.settimeout(3)
 print("Connection Status : CONNECTIONLESS (UDP)")
while True:
 text = input("Message Input (type exit to quit): ")
 if text.lower() == "exit":
 break
 packet = f"{client_id}: {text}".encode()
 start = time.perf_counter()
 try:
 if protocol == "TCP":
 sock.sendall(packet)
 reply = sock.recv(1024)
 else:
 sock.sendto(packet, (server_ip, port))
 reply, _ = sock.recvfrom(1024)
 end = time.perf_counter()
 print("Message Received :", reply.decode())
 print(f"Transmission Time : {(end - start) *  1000:.3f} ms")
 print("Acknowledgment : RECEIVED")
 except socket.timeout:
 print("Acknowledgment : NOT RECEIVED (timeout / packet lost)")
sock.close()
if protocol == "TCP":
 print("Connection Status : CLOSED")
